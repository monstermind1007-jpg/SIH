# Copy this file to .env for local development, then replace the placeholders.
JWT_SECRET_KEY=replace-with-a-long-random-secret
API_KEY=replace-with-a-different-random-secret
DEMO_EMAIL=demo@ministry.gov
DEMO_PASSWORD=replace-with-a-private-demo-password
SAVED_ANALYSES_DB=saved_analyses.db
REMOTENESS_ALLOW_ONLINE=0

# Optional Google Maps geocoding integration.
# GOOGLE_MAPS_API_KEY=

# Optional MySQL monitoring integration. Not needed for the SQLite demo.
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=monitoring